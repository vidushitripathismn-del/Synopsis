// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("INVENTORY_CLERK")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  assignedAssets        Asset[]                @relation("AssignedAssets")
  performedTransactions InventoryTransaction[]
  technicianMaintenance MaintenanceRecord[]    @relation("TechnicianMaintenance")
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@index([role])
  @@index([isActive])
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  users       User[]
  assets      Asset[]
}

model Location {
  id               String                 @id @default(cuid())
  name             String                 @unique
  type             String
  description      String?
  assets           Asset[]
  inventoryItems   InventoryItem[]
  transactionsFrom InventoryTransaction[] @relation("FromLocation")
  transactionsTo   InventoryTransaction[] @relation("ToLocation")
}

model Asset {
  id                 String              @id @default(cuid())
  serialNo           String              @unique
  name               String
  description        String?
  assetType          String
  locationId         String
  location           Location            @relation(fields: [locationId], references: [id])
  status             String              @default("AVAILABLE")
  purchaseDate       DateTime
  cost               Float
  warrantyExpiry     DateTime?
  assignedToId       String?
  assignedTo         User?               @relation("AssignedAssets", fields: [assignedToId], references: [id])
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id])
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([assetType])
}

model InventoryItem {
  id             String                 @id @default(cuid())
  name           String
  category       String
  unit           String
  quantityOnHand Float                  @default(0)
  reorderLevel   Float                  @default(0)
  locationId     String
  location       Location               @relation(fields: [locationId], references: [id])
  description    String?
  isActive       Boolean                @default(true)
  transactions   InventoryTransaction[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([category])
  @@index([isActive])
}

model InventoryTransaction {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  quantity       Float
  type           String
  date           DateTime      @default(now())
  fromLocationId String?
  fromLocation   Location?     @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?     @relation("ToLocation", fields: [toLocationId], references: [id])
  performedById  String
  performedBy    User          @relation(fields: [performedById], references: [id])
  notes          String?

  @@index([itemId])
  @@index([date])
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id])
  maintenanceType String
  scheduledDate   DateTime
  completedDate   DateTime?
  technicianId    String?
  technician      User?     @relation("TechnicianMaintenance", fields: [technicianId], references: [id])
  cost            Float?
  status          String    @default("SCHEDULED")
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([scheduledDate])
}

model AuditLog {
  id            String   @id @default(cuid())
  eventType     String
  entityType    String
  entityId      String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  details       String
  timestamp     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
